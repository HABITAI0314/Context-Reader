# 复制为 .env 后填写。这些值只存在于服务端，不会进入前端代码。

# 个人访问口令：在 App「设置」里填同一个值。请用一串足够长的随机字符。
ACCESS_TOKEN=change-me-to-a-long-random-string

# 模型服务（OpenAI 兼容的 chat/completions 接口）
# 地址写到 /v1 这一层，例如：
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   https://api.anthropic.com/v1   （Claude 的 OpenAI 兼容端点）
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name
AI_API_KEY=sk-xxxx

# 可选：服务端口（默认 8787）
# PORT=8787
# 可选：前端与后端不同域时，允许的前端来源，例如 https://reader.example.com
# ALLOWED_ORIGIN=
